# 复制为 .env.local 后再填真实值（.env.local 已被 .gitignore 排除，不会进仓库）

# Cesium Ion 访问令牌（选填）。本项目使用离线地形 + 自制底图，留空即可正常运行。
VITE_CESIUM_ION_TOKEN=

# 后端接口根地址
VITE_API_BASE_URL=http://127.0.0.1:8090/api/v1
# 后端静态资源根地址（业主头像 / 户型图回显）
VITE_API_ORIGIN=http://127.0.0.1:8090

# 本地三维服务根地址（PengJiang 地形、影像瓦片、楼栋 3D Tiles）
VITE_MODEL_BASE_URL=http://localhost:666
